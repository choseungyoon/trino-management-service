[Unit]
# Stateless. Safe to scale out: it reads snapshots from PostgreSQL and never
# polls Trino on a timer, so extra workers add no load to any coordinator
# (ARCHITECTURE.md principle A3). Write actions (kill) go straight to Trino from
# here, on the user's request only.
Description=TMS API - FastAPI service for the Trino Management Service
Documentation=https://github.com/choseungyoon/trino-management-service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Must match the owner of the virtualenv (TEAMS.md infra-agent).
User=tms
Group=tms
# Code and virtualenv live here; site secrets, the SSH key and the Ansible
# assets stay under /etc/tms. ProtectSystem=strict below makes all of /etc
# read-only, which is fine for running from it - the only visible effect is
# that Python cannot cache bytecode, so start-up recompiles each time.
WorkingDirectory=/etc/trino-management-service

Environment=PYTHONUNBUFFERED=1
Environment=TMS_CONFIG=/etc/trino-management-service/config/config.yaml
# Credentials arrive through the environment so they never enter the repo,
# which is PUBLIC. Keep this file 0600 and owned by root:tms.
EnvironmentFile=-/etc/tms/tms.env

ExecStart=/etc/trino-management-service/venv/bin/tms-api

Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=300
StartLimitBurst=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Kept on. Ansible mode does not need the real home - TMS gives the playbook a
# HOME under StateDirectory instead. The SSH key it uses must therefore live
# somewhere readable under this sandbox: /etc/tms/ssh/ works (ProtectSystem
# makes /etc read-only, which is all a key needs), a key under /home/tms does
# not.
ProtectHome=true
# systemd creates and owns /var/log/trino-management-service itself. An explicit
# ReadWritePaths= on a directory that does not exist yet makes the whole
# mount namespace fail to build - the unit then dies with 226/NAMESPACE
# before a single line of Python runs, which is a miserable first-deploy
# experience. Nothing writes here today (logs go to the journal); the
# directory exists so file logging can be added without touching this unit.
LogsDirectory=trino-management-service
# Writable state at /var/lib/trino-management-service, created and owned by
# systemd.
#
# ⛔ This setting takes a NAME, not a path - it is always relative to /var/lib,
# and an absolute path makes the unit fail to load. It must be kept equal to
# `cluster_ops.ansible.state_dir` in config.yaml by hand. They disagree
# silently: systemd still creates its directory, TMS still looks in a different
# one, and the mismatch only surfaces as tms-config-check failing or a blocked
# restart.
#
# ⛔ Required for cluster_ops.restart_mode: ansible. Ansible refuses to start
# without a writable HOME - measured on ansible-core 2.21, it aborts at import
# time with exit code 5 and "Unable to create local directories
# '~/.ansible/tmp'". ProtectHome=true below makes the service account's real
# home inaccessible, so TMS points the playbook's HOME here instead. Harmless
# when restart_mode is manual: nothing writes to it.
StateDirectory=trino-management-service
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tms-api

[Install]
WantedBy=multi-user.target
