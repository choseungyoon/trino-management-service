# Secrets — NFR-NO-SECRET. Never commit credentials.
config.secret.yaml
config.secret.yml
*.secret.yaml
*.secret.yml
.env
.env.*
*.pem
*.key
*.keystore
*.jks

# Python (FastAPI backend, 3.9+)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
build/
# ⛔ src/tms/ui/assets/ is the exception: the built console IS committed.
# Deployment is `git pull` + `pip install` onto a host with no Node on it, so
# anything absent from the repository is absent from the server (D-016).
!src/tms/ui/assets/

# Editor / OS
.DS_Store
.idea/
*.swp

# Local agent state (shared config under .claude/ is tracked)
.claude/settings.local.json

# Third-party design skills — reproducible, keep 7MB of vendored files out of
# the repo. Reinstall: `npx skills add Leonxlnx/taste-skill` + `npx impeccable install`
.claude/skills/
.agents/
.codex/
.impeccable/
PRODUCT.md.tmp

# Disposable local verification rig (Trino/PostgreSQL/certs) — never commit
scratchpad/
*.tsbuildinfo
