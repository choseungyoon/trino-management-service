# Copy to config.secret.yaml and fill in. That file is gitignored.
#
#   cp config/config.secret.yaml.example config/config.secret.yaml
#   chmod 600 config/config.secret.yaml
#
# Every value here can also be supplied through the environment, which is what
# the systemd units do via EnvironmentFile. Environment wins over file.
#
#   TMS_TRINO_PASSWORD    -> trino.password
#   TMS_DATABASE_URL      -> database.url
#   TMS_LDAP_BIND_PASSWORD-> ldap.bind_password

trino:
  # Password for the tms-svc basic auth account.
  password: CHANGE_ME

database:
  # Dedicated PostgreSQL instance (DECISIONS.md D-004). Deliberately NOT the
  # Gateway database: that one sits in the query routing path.
  url: postgresql://tms:CHANGE_ME@tms-db.example.internal:5432/tms

portal:
  # Signs session cookies. Must be IDENTICAL on every tms-api replica.
  # Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
  session_secret: CHANGE_ME

  # Temporary local accounts until AD integration (DECISIONS.md D-007).
  #
  # Generate each entry with:
  #     python3 scripts/hash_password.py --user <name> --roles admin --temporary
  #
  # Plaintext 'password' is rejected on purpose - only 'password_hash' is read.
  # Prefer one named account per person over a shared 'admin': every audit
  # record stores the account name, and a shared login makes "who killed this
  # query?" unanswerable, which is the question FR-AUDIT-ACTION exists for.
  local_users: {}
  #  syhcho:
  #    password_hash: "pbkdf2_sha256$600000$...$..."
  #    roles: [admin]
  #    must_change_password: true

# Reserved for the AD integration that replaces local_users.
ldap:
  bind_password: CHANGE_ME
